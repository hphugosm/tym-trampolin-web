---
import SitePage from "../components/site/SitePage.astro";
import { projects } from "../data/site";
import { locales, pagePaths, projectPath, blogPath, type PageKey, type Locale } from "../i18n/routes";
import { blogIdentity, publishedBlogEntries, type BlogEntry } from "../data/blog";
interface Props { locale: Locale; page: PageKey; projectId?: string; blogEntry?: BlogEntry }
export async function getStaticPaths() {
  const paths = locales.flatMap((locale) =>
    (Object.keys(pagePaths) as PageKey[])
      .filter(
        (page) =>
          !(
            locale === "en" &&
            ["home", "music", "privacy", "cookies", "missing"].includes(page)
          ),
      )
      .map((page) => ({
        params: {
          path: pagePaths[page][locale].replace(/^\//, "").replace(/\/$/, ""),
        },
        props: { locale, page },
      })),
  );
  return [
    ...paths,
    ...(await publishedBlogEntries()).filter((entry) => entry.data.presentation !== "shake-study").map((entry) => {
      const { locale, slug } = blogIdentity(entry);
      return {
        params: { path: blogPath(locale, slug).replace(/^\//, "").replace(/\/$/, "") },
        props: { locale, page: "blog" as const, blogEntry: entry },
      };
    }),
    ...locales.flatMap((locale) =>
      projects.map((project) => ({
        params: {
          path: projectPath(locale, project.id)
            .replace(/^\//, "")
            .replace(/\/$/, ""),
        },
        props: { locale, page: "projects" as const, projectId: project.id },
      })),
    ),
  ];
}
const { locale, page, projectId, blogEntry } = Astro.props;
---

<SitePage locale={locale} page={page} projectId={projectId} blogEntry={blogEntry} />
