---
import { brand, choose, contact, ui } from "../data/site";
import CopyEmail from "./site/CopyEmail.astro";
import {
  localeForPath,
  pagePath,
  type Locale,
  type PageKey,
} from "../i18n/routes";
interface Props {
  locale?: Locale;
}
const { locale = localeForPath(Astro.url.pathname) } = Astro.props;
const t = ui[locale];
const pages: PageKey[] = [
  "projects",
  "about",
  "journey",
  "blog",
  "collaborate",
  "gallery",
  "music",
];
---

<footer class="relative z-10 mt-20 rule-strong bg-[var(--color-ink-2)]">
  <div class="max-w-[80rem] mx-auto px-5 md:px-10 py-12 grid md:grid-cols-3 gap-9">
    <div>
      <a
        href={pagePath(locale, "home")}
        class="text-2xl text-white font-bold no-underline"
      >
        {brand[locale]}
      </a>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mt-4 max-w-sm">
        {t.footer}
      </p>
      <a
        href={`mailto:${contact.email}`}
        class="text-sm text-[var(--color-brand)] underline underline-offset-4 mt-5 inline-block break-all"
      >
        {contact.email}
      </a>
      <div><CopyEmail locale={locale} /></div>
      <div class="flex gap-5 mt-4">
        <a
          href={contact.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--color-text-secondary)] hover:text-white"
        >
          Instagram
        </a>
        <a
          href={contact.twitch}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--color-text-secondary)] hover:text-white"
        >
          Twitch
        </a>
      </div>
    </div>
    <nav
      aria-label={locale === "en" ? "Footer navigation" : "Navigace v patičce"}
      class="grid grid-cols-2 gap-x-6 gap-y-3 content-start"
    >
      {pages.map((page) => (
        <a
          href={pagePath(locale, page)}
          class="text-sm text-[var(--color-text-secondary)] hover:text-white"
        >
          {t[page as keyof typeof t]}
        </a>
      ))}
    </nav>
    <div>
      <p class="label !text-[0.65rem] text-white mb-4">{t.newsletter}</p>
      <p class="text-sm text-[var(--color-text-secondary)] mb-4">{choose(locale, "Updates on completed projects and competitions. Email us to unsubscribe.", "Novinky o dokončených projektech a soutěžích. Odběr odhlásíte e-mailem.")}</p>
      <form
        id="newsletter-form"
        class="flex flex-col gap-3"
        novalidate
        data-copy={JSON.stringify(t)}
      >
        <label for="newsletter-email" class="sr-only">
          {t.email}
        </label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          autocomplete="email"
          required
          aria-describedby="newsletter-privacy newsletter-msg"
          placeholder="email@example.com"
          class="w-full px-3 py-3 bg-transparent border border-[var(--color-line-strong)] text-white text-sm"
        />
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />
        <button type="submit" class="btn-outline self-start">
          {t.subscribe}
        </button>
      </form>
      <p id="newsletter-privacy" class="text-xs text-[var(--color-text-secondary)] mt-3"><a href={pagePath(locale, "privacy")} class="underline underline-offset-4">{choose(locale, "How we use your email", "Jak používáme váš e-mail")}</a></p>
      <p
        id="newsletter-msg"
        class="text-sm mt-3"
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </div>
  <div class="rule max-w-[80rem] mx-auto px-5 md:px-10 py-6 flex flex-col sm:flex-row justify-between gap-4">
    <p class="label !text-[0.6rem] text-[var(--color-text-muted)]">
      © {new Date().getFullYear()} {brand[locale]}
    </p>
    <div class="flex flex-wrap gap-5">
      <button type="button" class="text-xs text-[var(--color-text-secondary)] hover:text-white" data-effects-toggle aria-pressed="false"
        data-system={choose(locale, "Reduce effects", "Omezit efekty")}
        data-reduced={choose(locale, "Reduced effects on", "Efekty omezeny")}>{choose(locale, "Reduce effects", "Omezit efekty")}</button>
      {(["privacy", "cookies", "accessibility"] as const).map((page) => (
        <a
          href={pagePath(locale, page)}
          class="text-xs text-[var(--color-text-secondary)] hover:text-white"
        >
          {t[page]}
        </a>
      ))}
    </div>
  </div>
</footer>
<script>
  import "../scripts/effects";
  import { SUPABASE_URL, SUPABASE_KEY, track } from "../scripts/track";
  function initNewsletter() {
    const form = document.getElementById(
      "newsletter-form",
    ) as HTMLFormElement | null;
    const input = document.getElementById(
      "newsletter-email",
    ) as HTMLInputElement | null;
    const message = document.getElementById("newsletter-msg");
    if (!form || !input || !message || form.dataset.ready) return;
    form.dataset.ready = "1";
    const copy = JSON.parse(form.dataset.copy || "{}") as Record<
      string,
      string
    >;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (
        (form.elements.namedItem("website") as HTMLInputElement | null)?.value
      )
        return;
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        message.textContent = copy.newsletterInvalid;
        input.focus();
        return;
      }
      const button = form.querySelector("button")!;
      button.disabled = true;
      try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/tt_subscribers`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
            Prefer: "return=minimal",
          },
          body: JSON.stringify({ email, source: "web-footer" }),
        });
        if (response.status !== 409 && !response.ok)
          throw new Error(String(response.status));
        message.textContent =
          response.status === 409
            ? copy.newsletterExists
            : copy.newsletterSuccess;
        form.reset();
        if (response.ok) track("newsletter_signup", { source: "web-footer" });
      } catch {
        message.textContent = copy.newsletterError;
      } finally {
        button.disabled = false;
      }
    });
  }
  initNewsletter();
  document.addEventListener("astro:page-load", initNewsletter);
</script>
