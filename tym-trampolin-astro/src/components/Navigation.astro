---
import { brand, ui } from "../data/site";
import {
  alternatePath,
  localeForPath,
  pagePath,
  type Locale,
  type PageKey,
} from "../i18n/routes";
interface Props {
  active?: string;
  locale?: Locale;
  languagePaths?: Partial<Record<Locale, string>>;
}
const { active, locale = localeForPath(Astro.url.pathname) } = Astro.props;
const t = ui[locale];
const links: { page: PageKey; label: string }[] = [
  "projects",
  "about",
  "journey",
  "blog",
  "collaborate",
].map((page) => ({
  page: page as PageKey,
  label: t[page as "projects" | "about" | "journey" | "blog" | "collaborate"],
}));
const languagePaths = Astro.props.languagePaths ?? {
  en: alternatePath(Astro.url.pathname, "en"),
  cs: alternatePath(Astro.url.pathname, "cs"),
};
---

<nav
  id="main-nav"
  aria-label={locale === "en" ? "Main navigation" : "Hlavní navigace"}
  class="fixed top-0 left-0 right-0 z-[70] glass-over-media"
>
  <div class="max-w-[80rem] mx-auto px-5 md:px-10 h-16 flex items-center justify-between gap-3">
    <a
      href={pagePath(locale, "home")}
      class="flex items-center gap-2.5 no-underline shrink-0"
      aria-label={`${brand[locale]} — ${t.home}`}
    >
      <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="10" fill="var(--color-ink-3)" />
        <path d="M9 13h21v7.5h-6.5V40H15V20.5H9z" fill="var(--color-brand)" />
        <path d="M34 13h21v7.5h-6.5V40H40V20.5h-6z" fill="var(--color-brand)" />
        <path
          d="M10 47q22 12 44 0"
          stroke="var(--color-accent-2)"
          stroke-width="4"
          fill="none"
          stroke-linecap="round"
        />
        <circle cx="47" cy="42" r="4" fill="var(--color-gold)" />
      </svg>
      <span class="label !text-[0.65rem] sm:!text-xs text-white">
        {brand[locale]}
      </span>
    </a>
    <div class="hidden lg:flex items-center gap-1" data-desktop-nav>
      {links.map((link) => (
        <a
          href={pagePath(locale, link.page)}
          aria-current={active === link.page ? "page" : undefined}
          class:list={[
            "label !text-[0.65rem] px-3 py-3 no-underline transition-colors",
            active === link.page
              ? "text-[var(--color-brand)]"
              : "text-[var(--color-text-secondary)] hover:text-white",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="flex items-center gap-2 sm:gap-4">
      <div
        class="flex items-center border border-[var(--color-line-strong)]"
        aria-label={t.language}
        data-language-switch
      >
        {(["en", "cs"] as Locale[]).map((lang) => (
          languagePaths[lang] ? <a
            href={languagePaths[lang]}
            lang={lang}
            hreflang={lang}
            aria-label={
              lang === "en" ? "Switch to English" : "Přepnout do češtiny"
            }
            aria-current={locale === lang ? "true" : undefined}
            class:list={[
              "label !text-[0.65rem] min-w-9 min-h-10 flex items-center justify-center no-underline px-2",
              locale === lang
                ? "bg-[var(--color-brand)] text-[var(--color-ink)]"
                : "text-[var(--color-text-secondary)] hover:text-white",
            ]}
          >
            {lang.toUpperCase()}
          </a> : <span
            lang={lang}
            aria-disabled="true"
            title={lang === "en" ? "English translation not yet available" : "Český překlad zatím není k dispozici"}
            class="label !text-[0.65rem] min-w-9 min-h-10 flex items-center justify-center px-2 text-[var(--color-text-muted)]"
          >{lang.toUpperCase()}</span>
        ))}
      </div>
      <button
        id="nav-toggle"
        class="lg:hidden w-10 h-11 flex flex-col items-center justify-center gap-1.5 text-white"
        aria-label={t.menu}
        data-open-label={t.menu}
        data-close-label={t.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-line w-6 h-[2px] bg-current transition-transform"></span>
        <span class="nav-line w-6 h-[2px] bg-current transition-transform"></span>
      </button>
    </div>
  </div>
</nav>
<div
  id="mobile-menu"
  class="lg:hidden fixed inset-0 z-[60] hidden"
  inert
  aria-hidden="true"
>
  <div class="absolute inset-0 bg-[var(--color-ink)]"></div>
  <div
    class="relative flex flex-col gap-4 px-6 sm:px-10 pt-28 pb-10 h-full overflow-y-auto"
    role="navigation"
    aria-label={t.menu}
  >
    {links.map((link, i) => (
      <a
        href={pagePath(locale, link.page)}
        class:list={[
          "display-sm no-underline py-3",
          active === link.page ? "text-[var(--color-brand)]" : "text-white",
        ]}
        aria-current={active === link.page ? "page" : undefined}
      >
        <span class="label text-[var(--color-text-muted)] mr-4">0{i + 1}</span>
        {link.label}
      </a>
    ))}
  </div>
</div>
<style>
  #nav-toggle.active .nav-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  #nav-toggle.active .nav-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
</style>
<script>
  function initNav() {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu || toggle.dataset.navInit) return;
    toggle.dataset.navInit = "1";
    const controller = new AbortController();
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      menu.inert = !open;
      menu.setAttribute("aria-hidden", String(!open));
      toggle.classList.toggle("active", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) || "Menu",
      );
      document.body.style.overflow = open ? "hidden" : "";
      document
        .querySelectorAll<HTMLElement>("main, footer")
        .forEach((element) => {
          element.inert = open;
        });
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (toggle.getAttribute("aria-expanded") !== "true") return;
        if (event.key === "Escape") {
          setOpen(false);
          toggle.focus();
        }
        if (event.key === "Tab") {
          const items = [
            toggle,
            ...Array.from(menu.querySelectorAll<HTMLAnchorElement>("a")),
          ];
          const current = items.indexOf(document.activeElement as HTMLElement);
          const index =
            (current + (event.shiftKey ? -1 : 1) + items.length) % items.length;
          event.preventDefault();
          items[index].focus();
        }
      },
      { signal: controller.signal },
    );
    menu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));
    const desktop = window.matchMedia("(min-width: 1024px)");
    desktop.addEventListener(
      "change",
      () => {
        if (desktop.matches) setOpen(false);
      },
      { signal: controller.signal },
    );
    document.addEventListener(
      "astro:before-swap",
      () => {
        setOpen(false);
        controller.abort();
      },
      { once: true },
    );
  }
  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
