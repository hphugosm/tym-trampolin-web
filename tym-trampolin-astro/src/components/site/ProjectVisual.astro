---
import { choose, ui, type Project } from "../../data/site";
import type { Locale } from "../../i18n/routes";
interface Props { project: Project; locale: Locale; eager?: boolean; interactive?: boolean; }
const { project, locale, eager = false, interactive = true } = Astro.props;
const t = project.text[locale];
const screenshots = ["skyring", "titangoat", "olomouc"];
---
<div class="project-art" data-project-visual={project.id} transition:name={`project-${project.id}`}>
  {project.id === "clearmessage" && (
    <div class="document-preview">
      <span class="label">{choose(locale, "ClearMessage · Fictional example", "ClearMessage · Fiktivní příklad")}</span>
      <p class="message-text">{choose(locale, "Your parcel is waiting.", "Vaše zásilka čeká.")}<br /><strong>{choose(locale, "Pay now.", "Zaplaťte hned.")}</strong></p>
      <span class="message-caption">{choose(locale, "Understand the message. Choose your next step.", "Porozumějte zprávě. Zvolte další krok.")}</span>
    </div>
  )}
  {project.id === "real-estate-video" && (
    <div class="output-preview">
      <div><strong>6</strong><span class="label">{choose(locale, "Videos", "Videí")}</span></div>
      <div><strong>3</strong><span class="label">{choose(locale, "Real estate projects", "Realitní projekty")}</span></div>
      <span class="output-client label">RE/MAX</span>
    </div>
  )}
  {project.id === "website-studies" && project.studies && (
    <div class="web-showcase" data-web-showcase>
      <div class="showcase-bar label"><span data-study-title>SkyRing</span><span>{choose(locale, "Website study", "Ukázkový web")}</span></div>
      <img class="screen-image" data-study-image src="/media/previews/skyring.webp" alt={choose(locale, "SkyRing — website screenshot", "SkyRing — náhled webu")} width="960" height="540" loading={eager ? "eager" : "lazy"} />
      {interactive && <>
        <div class="study-controls" aria-label={choose(locale, "Website previews", "Náhledy webů")}>
          {project.studies.map((study, i) => <button type="button" data-study={study.title} data-src={`/media/previews/${screenshots[i]}.webp`} data-href={study.href} data-alt={choose(locale, `${study.title} — website screenshot`, `${study.title} — náhled webu`)} aria-pressed={i === 0}>{study.title}</button>)}
        </div>
        <a class="study-open" data-study-link href={project.studies[0].href} target="_blank" rel="noopener noreferrer">{ui[locale].openDemo}<span aria-hidden="true">↗</span></a>
      </>}
    </div>
  )}
  {project.id === "doom-bounce" && (
    <div class="doom-showcase">
      <div class="showcase-bar label"><span>DOOM Bounce</span><span>{choose(locale, "AI cutscene", "AI animovaná scéna")}</span></div>
      {interactive ? <>
        <video class="showcase-video" controls muted playsinline preload="none" poster="/media/previews/doom-cmd.webp" aria-label={choose(locale, "DOOM Bounce: animated introduction of CMD", "DOOM Bounce: animované představení CMD")}>
          <source src="/media/previews/doom-cmd.mp4" type="video/mp4" />
        </video>
        <a class="study-open" href="/tym_trampolin_doom.html" data-astro-reload>{ui[locale].playGame}<span aria-hidden="true">↗</span></a>
      </> : <img class="showcase-video" src="/media/previews/doom-cmd.webp" alt="DOOM Bounce · CMD" width="480" height="480" loading="lazy" />}
    </div>
  )}
  {project.id === "education-tools" && <div class="names-preview"><span>Academic<br />Vanguard</span><span>Berlin 2026</span></div>}
  {project.id === "ai-radio" && <div class="radio-preview"><span class="label">{choose(locale, "Broadcasting paused", "Vysílání pozastaveno")}</span><strong>AI RADIO</strong><span class="label">{t.category}</span></div>}
</div>
