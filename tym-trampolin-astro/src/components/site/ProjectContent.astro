---
import { choose, projects, ui, type Project } from "../../data/site";
import { pagePath, type Locale } from "../../i18n/routes";
import ProjectVisual from "./ProjectVisual.astro";
import ProjectCard from "./ProjectCard.astro";
import GameEmbed from "../demos/GameEmbed.astro";
import CollaborationCTA from "./CollaborationCTA.astro";
interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const t = project.text[locale];
const labels = ui[locale];
const related = projects.filter((p) => p.id !== project.id).slice(0, 2);
---

<article data-project-detail={project.id}>
  <header class="relative z-10 pt-32 md:pt-36 pb-10 px-5 md:px-10">
    <div class="max-w-[80rem] mx-auto">
      <a href={pagePath(locale, "projects")} class="link-button mb-8">
        ← {labels.allProjects}
      </a>
      <p class="eyebrow mb-5">{t.category}</p>
      <h1 class="display-lg text-white mb-6">{t.title}</h1>
      <p class="text-lg md:text-xl text-[var(--color-text-secondary)] max-w-3xl leading-relaxed mb-8">
        {t.summary}
      </p>
      <dl class="flex flex-wrap gap-x-10 gap-y-5 text-sm">
        <div>
          <dt class="label !text-[0.62rem] text-[var(--color-text-muted)] mb-2">
            {labels.status}
          </dt>
          <dd class="text-[var(--color-brand)]">{t.status}</dd>
        </div>
        <div>
          <dt class="label !text-[0.62rem] text-[var(--color-text-muted)] mb-2">
            {labels.author}
          </dt>
          <dd class="text-white">{project.authors.join(", ")}</dd>
        </div>
        <div>
          <dt class="label !text-[0.62rem] text-[var(--color-text-muted)] mb-2">
            {labels.year}
          </dt>
          <dd class="text-white">{project.year}</dd>
        </div>
      </dl>
    </div>
  </header>
  <div class="max-w-[80rem] mx-auto px-5 md:px-10 mb-14">
    <div class="border border-[var(--color-line-strong)] max-w-4xl">
      <ProjectVisual project={project} locale={locale} eager={true} />
    </div>
  </div>
  <section class="rule px-5 md:px-10 py-14">
    <div class="max-w-[80rem] mx-auto grid lg:grid-cols-[2fr_1fr] gap-12">
      <div
        class="max-w-3xl space-y-10"
        data-track-view="project_detail_view"
        data-track-meta={JSON.stringify({ project: project.id, locale })}
      >
        <div>
          <h2 class="display-sm text-white mb-4">{labels.why}</h2>
          <p class="text-[var(--color-text-secondary)] leading-relaxed">
            {t.why}
          </p>
        </div>
        <div>
          <h2 class="display-sm text-white mb-4">{labels.made}</h2>
          {t.made.map((paragraph) => (
            <p class="text-[var(--color-text-secondary)] leading-relaxed mb-4">
              {paragraph}
            </p>
          ))}
        </div>
        {t.note && (
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed border-l-2 border-[var(--color-brand)] pl-5">
            {t.note}
          </p>
        )}
        <div>
          <h2 class="display-sm text-white mb-4">{labels.next}</h2>
          <p class="text-[var(--color-text-secondary)] leading-relaxed">
            {t.next}
          </p>
        </div>
      </div>
      <aside class="border-t lg:border-t-0 lg:border-l border-[var(--color-line)] pt-7 lg:pt-0 lg:pl-8">
        <h2 class="label text-white mb-5">{labels.technology}</h2>
        <ul class="flex flex-wrap gap-2 mb-9">
          {project.stack.map((technology) => (
            <li class="text-sm text-[var(--color-text-secondary)] border border-[var(--color-line)] px-3 py-1">
              {technology}
            </li>
          ))}
        </ul>
        {project.links.length > 0 && (
          <>
            <h2 class="label text-white mb-5">{labels.evidence}</h2>
            <div class="flex flex-col gap-4">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    link.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                  class="text-sm text-[var(--color-brand)] underline underline-offset-4"
                >
                  {link.label[locale]} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </>
        )}
        {project.id === "real-estate-video" && (
          <a href={pagePath(locale, "collaborate")} class="btn-outline mt-2">
            {choose(locale, "Discuss a video project", "Probrat video projekt")}
          </a>
        )}
      </aside>
    </div>
  </section>
  {project.studies && (
    <section class="rule px-5 md:px-10 py-14">
      <div class="max-w-[80rem] mx-auto">
        <h2 class="display-sm text-white mb-8">{labels.evidence}</h2>
        <div class="grid md:grid-cols-2 gap-5">
          {project.studies.map((study) => (
            <div class="border border-[var(--color-line)] p-6 md:p-8">
              <h3 class="text-xl text-white mb-3">{study.title}</h3>
              <p class="text-sm text-[var(--color-text-secondary)] mb-6">
                {study.description[locale]}
              </p>
              <div class="flex flex-wrap gap-6">
                <a
                  class="link-button"
                  href={study.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {labels.openDemo} ↗
                </a>
                <a
                  class="link-button"
                  href={study.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {labels.viewCode} ↗
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
  {project.id === "doom-bounce" && (
    <section class="rule py-14 px-5 md:px-10">
      <div class="max-w-[80rem] mx-auto">
        <h2 class="display-sm text-white mb-5">{labels.playGame}</h2>
        <p class="text-sm text-[var(--color-text-muted)] mb-7">
          {labels.gameNote}
        </p>
        <GameEmbed
          src="tym_trampolin_doom.html"
          title="DOOM Bounce"
          poster="media/doom/doom_title.webp"
          locale={locale}
        />
      </div>
    </section>
  )}
</article>
<section class="rule px-5 md:px-10 py-16">
  <div class="max-w-[80rem] mx-auto">
    <h2 class="display-sm text-white mb-8">{labels.related}</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {related.map((p) => (
        <ProjectCard project={p} locale={locale} />
      ))}
    </div>
  </div>
</section>
<CollaborationCTA locale={locale} />
