---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "@fontsource/chakra-petch/500.css";
import "@fontsource/chakra-petch/600.css";
import "@fontsource/chakra-petch/700.css";
import "../../styles/cyber.css";
import Navigation from "../Navigation.astro";
import Footer from "../Footer.astro";
import HomeContent from "./HomeContent.astro";
import ProjectsContent from "./ProjectsContent.astro";
import ProjectContent from "./ProjectContent.astro";
import DoomContent from "./DoomContent.astro";
import AboutContent from "./AboutContent.astro";
import JourneyContent from "./JourneyContent.astro";
import CollaborateContent from "./CollaborateContent.astro";
import GalleryContent from "./GalleryContent.astro";
import MusicContent from "./MusicContent.astro";
import BlogContent from "./BlogContent.astro";
import BlogArticle from "./BlogArticle.astro";
import { blogAlternates, publishedBlogEntries, type BlogEntry } from "../../data/blog";
import LegalContent from "./LegalContent.astro";
import PageHeading from "./PageHeading.astro";
import { brand, pageCopy, projectById, ui } from "../../data/site";
import { pagePath, type Locale, type PageKey } from "../../i18n/routes";
interface Props {
  locale: Locale;
  page: PageKey;
  projectId?: string;
  blogEntry?: BlogEntry;
}
const { locale, page, projectId, blogEntry } = Astro.props;
const project = projectId ? projectById(projectId) : undefined;
if (projectId && !project)
  throw new Error(`Unknown public project: ${projectId}`);
const copy = pageCopy[locale][page];
const title = `${blogEntry?.data.title ?? (project ? project.text[locale].title : copy.title)} — ${brand[locale]}`;
const languagePaths = blogEntry ? blogAlternates(blogEntry, await publishedBlogEntries()) : undefined;
---

<BaseLayout
  cyber
  title={title}
  description={blogEntry?.data.description ?? project?.text[locale].summary ?? copy.description}
  ogImage={project ? `/media/og/${project.id}-${locale}.png` : undefined}
  locale={locale}
  languagePaths={languagePaths}
  ogType={blogEntry ? "article" : "website"}
  noindex={page === "missing"}
>
  {project && <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "CreativeWork",
    name: project.text[locale].title, description: project.text[locale].summary,
    url: new URL(Astro.url.pathname, Astro.site).href, inLanguage: locale,
    author: project.authors.map(name => ({ "@type": "Person", name })),
    keywords: project.stack.join(", "),
  })} />}
  {blogEntry && <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BlogPosting",
    headline: blogEntry.data.title, description: blogEntry.data.description,
    url: new URL(Astro.url.pathname, Astro.site).href,
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
    inLanguage: locale, datePublished: blogEntry.data.publishedAt,
    dateModified: blogEntry.data.updatedAt ?? blogEntry.data.publishedAt,
    author: { "@type": "Person", name: blogEntry.data.author },
    publisher: { "@type": "Organization", name: brand[locale], url: Astro.site?.href },
    keywords: blogEntry.data.tags,
    image: new URL(`/media/og/default-${locale}.png`, Astro.site).href,
    ...(blogEntry.data.magazine?.url ? { isBasedOn: blogEntry.data.magazine.url } : {}),
  }).replace(/</g, "\\u003c")} />}
  <Navigation slot="navigation" active={page} locale={locale} languagePaths={languagePaths} />
  {page === "blog" && (blogEntry ? <BlogArticle locale={locale} entry={blogEntry} /> : <BlogContent locale={locale} />)}
  {page === "home" && <HomeContent locale={locale} />}
  {page === "projects" &&
    (project ? (
      project.id === "doom-bounce" ? (
        <DoomContent project={project} locale={locale} />
      ) : (
        <ProjectContent project={project} locale={locale} />
      )
    ) : (
      <ProjectsContent locale={locale} />
    ))}
  {page === "about" && <AboutContent locale={locale} />}
  {page === "journey" && <JourneyContent locale={locale} />}
  {page === "collaborate" && <CollaborateContent locale={locale} />}
  {page === "gallery" && <GalleryContent locale={locale} />}
  {page === "music" && <MusicContent locale={locale} />}
  {(page === "privacy" || page === "cookies" || page === "accessibility") && (
    <LegalContent page={page} locale={locale} />
  )}
  {page === "missing" && (
    <>
      <PageHeading
        label="404"
        heading={copy.heading}
        description={copy.description}
      />
      <div class="max-w-[80rem] mx-auto px-5 md:px-10 pb-16">
        <a href={pagePath(locale, "home")} class="btn-primary">
          {ui[locale].home} →
        </a>
      </div>
    </>
  )}
  <Footer slot="footer" locale={locale} />
</BaseLayout>
<script>
  import "../../scripts/cyber";
</script>
