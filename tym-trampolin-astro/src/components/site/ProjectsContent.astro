---
import { projects, pageCopy, choose } from "../../data/site";
import type { Locale } from "../../i18n/routes";
import PageHeading from "./PageHeading.astro";
import ProjectDirectory from "./ProjectDirectory.astro";
import CollaborationCTA from "./CollaborationCTA.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<PageHeading
  label={choose(
    locale,
    `${projects.length} project areas`,
    `${projects.length} projektových oblastí`,
  )}
  heading={pageCopy[locale].projects.heading}
  description={pageCopy[locale].projects.description}
/>
<section class="max-w-[80rem] mx-auto px-5 md:px-10 pb-12">
  <ProjectDirectory locale={locale} />
</section>
<CollaborationCTA locale={locale} />
