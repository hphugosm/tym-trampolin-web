---
import "@fontsource/press-start-2p/index.css";
import "../../styles/doom.css";
import { choose, projectById, ui, type Project } from "../../data/site";
import { pagePath, projectPath, type Locale } from "../../i18n/routes";

interface Props { locale: Locale; project: Project }
const { locale, project } = Astro.props;
const t = project.text[locale];
const labels = ui[locale];
const tr = (en: string, cs: string) => choose(locale, en, cs);
// Names, waves and abilities come from BOSS_LADDER / BESTIARY_BOSSES in the game.
const bosses = [
  { id: "cmd", name: "cmd", wave: "14", color: "#8cffa1",
    type: tr("System intruder", "Narušitel systému"),
    description: tr("Reversed controls, a glitching screen and teleportation. Keep your aim steady when cmd takes over.", "Obrácené ovládání, glitchující obraz a teleportace. Když cmd převezme kontrolu, zastav se a soustřeď se na míření.") },
  { id: "deniska", name: "Deniska tým", wave: "04", color: "#ffa5dc",
    type: tr("Clone commander", "Velitelka klonů"),
    description: tr("She keeps summoning copies of herself. Find the original and concentrate your fire.", "Neustále svolává kopie sebe sama. Najdi originál a soustřeď na něj palbu.") },
  { id: "karl", name: "Tlustej Kárl", wave: "06", color: "#c1acff",
    type: tr("Donut apocalypse", "Donutová apokalypsa"),
    description: tr("A fan of flying donuts becomes a barrage of giant rolling ones. Dodge sideways; backing away won't save you.", "Vějíř létajících donutů vystřídají obří valící se donuty. Uhýbej do stran, couvání tě nezachrání.") },
  { id: "nerudovka", name: "Nerudovka", wave: "20", color: "#ffda80",
    type: tr("The final brushstroke", "Poslední tah štětcem"),
    description: tr("Painted traps, a changing reality and three phases. In the finale, listen for the brush behind you.", "Namalované pasti, proměnlivá realita a tři fáze. Ve finále poslouchej štětec za svými zády.") },
];
const related = ["website-studies", "real-estate-video"].map(id => projectById(id)!);
---

<article class="doom-page" data-project-detail={project.id} data-doom-page>
  <div class="doom-shell">
    <div class="doom-breadcrumb doom-mono">
      <a href={pagePath(locale, "projects")}>← {labels.allProjects}</a>
      <span>{tr("Trampolin / Game lab", "Trampolín / Herní laboratoř")}</span>
    </div>

    <header class="doom-machine" data-doom-fx="cabinet">
      <div class="doom-machine-bar doom-mono">
        <span><i class="doom-led" aria-hidden="true"></i> {t.status}</span>
        <span>{project.year} <span aria-hidden="true">//</span> {tr("Browser edition", "Verze pro prohlížeč")}</span>
      </div>
      <div class="doom-hero">
        <div class="doom-hero-copy">
          <p class="doom-kicker">{t.category}</p>
          <h1 class="doom-title" aria-label={t.title}>{["DOOM", "BOUNCE"].map(word => <span>{word}<span class="doom-title-ghost" data-word={word} aria-hidden="true"></span><span class="doom-title-ghost" data-word={word} aria-hidden="true"></span></span>)}</h1>
          <p class="doom-summary">{t.summary}</p>
          <div class="doom-actions" data-doom-menu role="group" aria-label={tr("Game menu", "Herní menu")} aria-describedby="doom-menu-hint">
            <a href="#play" class="doom-button" data-doom-start-link>
              <svg class="doom-menu-cursor" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 1h8v2h2v8h-3v4H9v-3H7v3H5v-4H2V3h2zm0 4v3h3V5zm5 0v3h3V5z" /></svg> {tr("Start game", "Spustit hru")}
            </a>
            <a href="#briefing" class="doom-text-link">{tr("Mission briefing", "Zadání mise")} <span aria-hidden="true">↓</span></a>
          </div>
          <p class="doom-hero-note doom-mono">{tr("No install. Straight into the browser.", "Bez instalace. Přímo v prohlížeči.")}</p>
          <div class="doom-menu-settings doom-mono">
            <p id="doom-menu-hint"><kbd>↑ ↓</kbd> {tr("Select", "Výběr")} <span aria-hidden="true">/</span> <kbd>ENTER</kbd> {tr("Confirm", "Potvrdit")}</p>
            <button type="button" data-effects-toggle aria-pressed="false" data-system={tr("Reduce effects", "Omezit efekty")} data-reduced={tr("Reduced effects on", "Efekty omezeny")}>{tr("Reduce effects", "Omezit efekty")}</button>
          </div>
        </div>
        <figure class="doom-cover">
          <div class="doom-pixel-art doom-cover-screen" data-doom-pixels="320">
            <img src="/media/doom/cs_intro.webp" alt={tr("Game artwork: three competitors, a glowing trophy and a distorted leaderboard", "Grafika ze hry: tři soutěžící, zářící trofej a porouchaný žebříček")} width="1600" height="893" fetchpriority="high" />
            <canvas aria-hidden="true"></canvas>
            <span class="doom-crt-sweep" aria-hidden="true"></span>
          </div>
          <figcaption class="doom-mono"><span>{tr("The climb to the top", "Cesta na vrchol")}</span><span>{tr("Game artwork", "Grafika ze hry")}</span></figcaption>
        </figure>
      </div>
      <dl class="doom-hud">
        <div><dt>{tr("Campaign waves", "Vln v kampani")}</dt><dd>20</dd></div>
        <div><dt>{tr("Main bosses", "Hlavních bossů")}</dt><dd>10</dd></div>
        <div class="doom-hud-engine"><dt>{tr("Custom engine", "Vlastní engine")}</dt><dd>RAYCASTING</dd></div>
        <div class="doom-hud-author"><dt>{labels.author}</dt><dd>{project.authors.join(", ")}</dd></div>
      </dl>
    </header>

    <nav class="doom-level-nav doom-mono" data-doom-menu aria-label={tr("On this project page", "Na stránce projektu")}>
      <a href="#briefing"><span>01</span> {tr("Briefing", "Zadání")}</a>
      <a href="#bosses"><span>02</span> {tr("Boss files", "Bossové")}</a>
      <a href="#play"><span>03</span> {tr("Play", "Hrát")}</a>
    </nav>

    <section id="briefing" class="doom-section" aria-labelledby="doom-briefing-title" data-track-view="project_detail_view" data-track-meta={JSON.stringify({ project: project.id, locale })}>
      <div class="doom-section-heading"><span class="doom-level">01</span><h2 id="doom-briefing-title">{tr("Mission briefing", "Zadání mise")}</h2><span class="doom-section-rule" aria-hidden="true"></span></div>
      <div class="doom-briefing-grid">
        <div class="doom-briefing-copy">
          <p class="doom-kicker">{labels.why}</p>
          <p class="doom-question">{t.why}</p>
          <h3>{labels.made}</h3>
          {t.made.map(paragraph => <p>{paragraph}</p>)}
          {t.note && <p>{t.note}</p>}
          <div class="doom-next"><h3>{labels.next}</h3><p>{t.next}</p></div>
          <h3>{labels.technology}</h3>
          <ul class="doom-stack">{project.stack.map(item => <li>{item === "AI animation" ? tr(item, "AI animace") : item === "AI voices" ? tr(item, "AI hlasy") : item}</li>)}</ul>
        </div>
        <figure class="doom-cutscene doom-panel">
          <div class="doom-panel-label doom-mono"><span>{tr("Cutscene preview", "Ukázka animace")}</span><span>cmd</span></div>
          <video controls muted playsinline preload="none" poster="/media/previews/doom-cmd.webp" aria-label={tr("DOOM Bounce: AI-animated introduction of cmd", "DOOM Bounce: AI animovaný úvod bosse cmd")}>
            <source src="/media/previews/doom-cmd.mp4" type="video/mp4" />
            <a href="/media/previews/doom-cmd.mp4">{tr("Watch the animation", "Přehrát animaci")}</a>
          </video>
          <figcaption><span class="doom-kicker">{tr("From code to cutscene", "Od kódu k animaci")}</span><p>{tr("Custom game logic, AI-generated animations and voices. One experiment across programming and creative production.", "Vlastní herní logika, AI animace a hlasy. Jeden experiment napříč programováním a kreativní produkcí.")}</p></figcaption>
        </figure>
      </div>
    </section>

    <section id="bosses" class="doom-section" aria-labelledby="doom-bosses-title">
      <div class="doom-section-heading"><span class="doom-level">02</span><h2 id="doom-bosses-title">{tr("Meet the bosses", "Seznam se s bossy")}</h2><span class="doom-section-rule" aria-hidden="true"></span></div>
      <p class="doom-section-intro">{tr("Four opponents from a campaign inspired by the DemocraTICon final. Each plays by different rules.", "Čtyři soupeři z kampaně inspirované finále DemocraTIConu. Každý hraje podle jiných pravidel.")}</p>
      <div class="doom-boss-selector" data-doom-menu role="group" aria-label={tr("Choose a boss to preview", "Vyber bosse k prohlédnutí")} hidden data-doom-selector>
        {bosses.map((boss, i) => <button type="button" data-doom-boss={boss.id} aria-controls={`boss-${boss.id}`} aria-pressed={i === 0 ? "true" : "false"} style={`--boss-color:${boss.color}`}><span class="doom-mono">{String(i + 1).padStart(2, "0")}</span><span>{boss.name}</span><span class="doom-boss-marker" aria-hidden="true">▶</span></button>)}
      </div>
      <div class="doom-boss-files">
        {bosses.map(boss => <div id={`boss-${boss.id}`} class="doom-boss-panel doom-panel" data-doom-fx="boss" data-doom-boss-panel={boss.id} style={`--boss-color:${boss.color}`}>
          <div class="doom-boss-art doom-pixel-art" data-doom-pixels="192"><img src={`/media/doom/boss_${boss.id}.webp`} alt={tr(`Game portrait of ${boss.name}`, `Herní portrét: ${boss.name}`)} width="1024" height="1024" loading="lazy" decoding="async" /><canvas aria-hidden="true"></canvas></div>
          <div class="doom-boss-copy"><p class="doom-kicker">{tr("Boss encounter", "Souboj s bossem")} <span aria-hidden="true">//</span> {tr("Wave", "Vlna")} {boss.wave}</p><h3>{boss.name}</h3><p class="doom-boss-type">{boss.type}</p><p>{boss.description}</p><a href="#play" class="doom-text-link">{tr("Meet them in game", "Potkej je ve hře")} <span aria-hidden="true">↗</span></a></div>
        </div>)}
      </div>
    </section>

    <section id="play" class="doom-section" aria-labelledby="doom-play-title">
      <div class="doom-section-heading"><span class="doom-level">03</span><h2 id="doom-play-title">{tr("Your turn", "Teď hraješ ty")}</h2><span class="doom-section-rule" aria-hidden="true"></span></div>
      <div class="doom-game doom-machine" data-doom-game>
        <div class="doom-game-toolbar doom-mono"><span>DOOM BOUNCE</span><div><button type="button" data-doom-stop hidden>{tr("Close game", "Zavřít hru")} ×</button><a href="/tym_trampolin_doom.html" target="_blank" rel="noopener" data-track="external_game_click" data-track-meta={JSON.stringify({ project: project.id, locale })}>{tr("Open separately", "Otevřít samostatně")} ↗</a></div></div>
        <div class="doom-game-screen" data-doom-game-screen>
          <div class="doom-game-poster" data-doom-game-poster data-doom-fx="poster">
            <img src="/media/doom/doom_title.webp" alt="" width="1400" height="782" loading="lazy" />
            <div><p class="doom-insert">{tr("Ready to bounce?", "Připraven na odraz?")}</p><button type="button" class="doom-button" data-doom-start><svg class="doom-menu-cursor" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 1h8v2h2v8h-3v4H9v-3H7v3H5v-4H2V3h2zm0 4v3h3V5zm5 0v3h3V5z" /></svg> {labels.playGame}</button><p class="doom-mono">{labels.gameNote}</p></div>
          </div>
        </div>
        <noscript><p class="doom-noscript">{tr("Open the game on its own page to play.", "Pro hraní otevři hru na samostatné stránce.")} <a href="/tym_trampolin_doom.html">{labels.playGame} →</a></p></noscript>
        <div class="doom-controls"><span><kbd>W A S D</kbd> {tr("Move", "Pohyb")}</span><span><kbd>{tr("MOUSE", "MYŠ")}</kbd> {tr("Aim / fire", "Míření / střelba")}</span><span><kbd>SHIFT</kbd> {tr("Sprint", "Sprint")}</span><span><kbd>ESC / P</kbd> {tr("Pause", "Pauza")}</span></div>
      </div>
      <p class="doom-game-note">{tr("On mobile, use the on-screen controls and turn your phone sideways. Open the game separately for more space. The game interface and voices are in Czech.", "Na mobilu použij dotykové ovládání a otoč telefon na šířku. Pro více místa otevři hru samostatně. Rozhraní hry i hlasy jsou v češtině.")}</p>
    </section>

    <section class="doom-related doom-section" aria-labelledby="doom-related-title">
      <h2 id="doom-related-title">{labels.related}</h2>
      <div>{related.map(p => <a href={projectPath(locale, p.id)}><span class="doom-kicker">{p.text[locale].category}</span><strong>{p.text[locale].title} <span aria-hidden="true">↗</span></strong><p>{p.text[locale].summary}</p></a>)}</div>
    </section>
    <section class="doom-outro doom-panel">
      <div><p class="doom-kicker">{labels.collaborate}</p><h2>{tr("A project or an opportunity?", "Projekt nebo příležitost?")}</h2><p>{tr("We are open to client work, internships, research mentoring, and support for our next experiments.", "Zajímají nás zakázky, stáže, výzkumný mentoring a podpora dalších experimentů.")}</p></div>
      <a class="doom-button doom-button-secondary" href={pagePath(locale, "collaborate")}>{labels.reachOut} <span aria-hidden="true">→</span></a>
    </section>
  </div>
</article>
<script>
  import "../../scripts/doom-page";
</script>
