---
import SectionHeading from "../SectionHeading.astro";
import PageHeading from "./PageHeading.astro";
import { choose, pageCopy } from "../../data/site";
import type { Locale } from "../../i18n/routes";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const brandGrad = "from-[#4fc8ff] to-[#7d8bff]";
const tracks = [
  {
    id: "original",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Original",
    genre: "original",
    file: `${base}media/album/original.mp3`,
    color: brandGrad,
  },
  {
    id: "phonk1",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Phonk I",
    genre: "phonk",
    file: `${base}media/album/phonk1.mp3`,
    color: brandGrad,
  },
  {
    id: "phonk2",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Phonk II",
    genre: "phonk",
    file: `${base}media/album/phonk2.mp3`,
    color: brandGrad,
  },
  {
    id: "hardstyle1",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Hardstyle I",
    genre: "hardstyle",
    file: `${base}media/album/hardstyle1.mp3`,
    color: brandGrad,
  },
  {
    id: "hardstyle2",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Hardstyle II",
    genre: "hardstyle",
    file: `${base}media/album/hardstyle2.mp3`,
    color: brandGrad,
  },
  {
    id: "hooligans",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Hooligans",
    genre: "hooligans",
    file: `${base}media/album/hooligans.mp3`,
    color: brandGrad,
  },
  {
    id: "tribe1",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Tribe I",
    genre: "tribe",
    file: `${base}media/album/tribe1.mp3`,
    color: brandGrad,
  },
  {
    id: "tribe2",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Tribe II",
    genre: "tribe",
    file: `${base}media/album/tribe2.mp3`,
    color: brandGrad,
  },
  {
    id: "epic1",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Epic I",
    genre: "epic",
    file: `${base}media/album/epic1.mp3`,
    color: brandGrad,
  },
  {
    id: "epic2",
    title: choose(locale, "TT Anthem", "Hymna TT"),
    subtitle: "Epic II",
    genre: "epic",
    file: `${base}media/album/epic2.mp3`,
    color: brandGrad,
  },
];
---

<PageHeading
  label={choose(
    locale,
    "Competition archive · 10 tracks",
    "Soutěžní archiv · 10 skladeb",
  )}
  heading={pageCopy[locale].music.heading}
  description={pageCopy[locale].music.description}
/>
<!-- NOW PLAYING -->
<section class="relative z-10 rule py-12 px-5 md:px-10">
  <div class="max-w-2xl mx-auto">
    <div
      class="bg-[var(--color-ink-2)] border-2 border-[var(--color-line-strong)] p-6 relative overflow-hidden"
      id="player-card"
    >
      <div
        class="absolute inset-0 opacity-20 transition-all duration-500"
        id="player-bg"
      ></div>
      <canvas
        id="visualizer"
        class="absolute inset-x-0 bottom-0 h-16 w-full pointer-events-none opacity-70"
        aria-hidden="true"
      ></canvas>

      <div class="relative flex items-center gap-6">
        <!-- Vinyl -->
        <div
          class="shrink-0 w-20 h-20 rounded-full bg-gradient-to-br from-[var(--color-accent)]/30 to-[var(--color-accent-2)]/30 flex items-center justify-center border-2 border-white/10"
          id="vinyl"
        >
          <div class="w-6 h-6 rounded-full bg-[var(--color-bg-deep)] border border-white/20"></div>
        </div>

        <div class="flex-1 min-w-0">
          <div
            class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider mb-1"
            id="now-genre"
          >
            ---
          </div>
          <div class="text-lg font-bold text-white truncate" id="now-title">
            {choose(locale, "Choose a track", "Vyberte skladbu")}
          </div>
          <div
            class="text-sm text-[var(--color-text-secondary)]"
            id="now-subtitle"
          >
            ---
          </div>

          <!-- Progress bar -->
          <div class="mt-3 flex items-center gap-3">
            <span
              class="text-xs text-[var(--color-text-muted)] font-mono w-10"
              id="time-current"
            >
              0:00
            </span>
            <input id="progress-bar" type="range" min="0" max="1" step="1" value="0" disabled
              aria-label={choose(locale, "Playback position", "Pozice přehrávání")}
              class="min-w-0 flex-1 h-8 accent-[var(--color-accent)] cursor-pointer" />
            <span
              class="text-xs text-[var(--color-text-muted)] font-mono w-10 text-right"
              id="time-total"
            >
              0:00
            </span>
          </div>
        </div>
      </div>

      <p id="player-status" class="sr-only" role="status" aria-live="polite"></p>
      <!-- Controls -->
      <div class="relative flex items-center justify-center gap-4 mt-5">
        <button
          id="btn-prev"
          class="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/10 flex items-center justify-center text-white transition-colors"
          aria-label={choose(locale, "Previous track", "Předchozí skladba")}
        >
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9.195 18.44c1.25.713 2.805-.19 2.805-1.629v-2.34l6.945 3.968c1.25.714 2.805-.188 2.805-1.628V7.19c0-1.44-1.555-2.342-2.805-1.628L12 9.53V7.19c0-1.44-1.555-2.342-2.805-1.628l-6.945 3.97c-1.25.713-1.25 2.522 0 3.236l6.945 3.97z" />
          </svg>
        </button>
        <button
          id="btn-play"
          class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-2)] hover:scale-105 flex items-center justify-center text-white transition-transform shadow-lg shadow-[var(--color-accent-glow)]"
          aria-label={choose(
            locale,
            "Play",
            "Přehrát",
          )}
        >
          <svg
            id="icon-play"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
          <svg
            id="icon-pause"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 24 24"
            class="hidden"
          >
            <path d="M6.75 5.25a.75.75 0 01.75-.75H9a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H7.5a.75.75 0 01-.75-.75V5.25zm7.5 0A.75.75 0 0115 4.5h1.5a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H15a.75.75 0 01-.75-.75V5.25z" />
          </svg>
        </button>
        <button
          id="btn-next"
          class="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/10 flex items-center justify-center text-white transition-colors"
          aria-label={choose(locale, "Next track", "Další skladba")}
        >
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M5.055 7.06c-1.25-.714-2.805.189-2.805 1.628v9.62c0 1.44 1.555 2.342 2.805 1.628L12 16.47v2.342c0 1.44 1.555 2.342 2.805 1.628l6.945-3.97c1.25-.715 1.25-2.523 0-3.237L14.805 9.26c-1.25-.714-2.805.189-2.805 1.628v2.342L5.055 9.26z"
              transform="translate(0,0)"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- TRACK LIST -->
<section class="relative z-10 py-16 px-5 md:px-10">
  <div class="max-w-4xl mx-auto">
    <SectionHeading
      index="01"
      label={choose(locale, "Tracklist", "Seznam skladeb")}
      title={choose(locale, "All tracks", "Všechny skladby")}
      center={false}
    />

    <div class="border border-[var(--color-line)]" id="track-list">
      {tracks.map((track, i) => (
        <button
          class:list={[
            "track-item w-full flex items-center gap-4 p-4 transition-colors duration-200 hover:bg-[var(--color-ink-2)] text-left group",
            i > 0 && "border-t border-[var(--color-line)]",
          ]}
          data-index={i}
          data-genre={track.genre}
          data-title={track.title}
          data-subtitle={track.subtitle}
          data-src={track.file}
          data-color={track.color}
        >
          <div class="w-8 text-center">
            <span class="track-number text-sm text-[var(--color-text-muted)] font-mono group-hover:hidden">
              {String(i + 1).padStart(2, "0")}
            </span>
            <svg
              class="track-play-icon hidden group-hover:block mx-auto"
              width="16"
              height="16"
              fill="var(--color-accent-bright)"
              viewBox="0 0 24 24"
            >
              <path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
            </svg>
          </div>
          <div
            class={`w-10 h-10 bg-gradient-to-br ${track.color} opacity-70 flex items-center justify-center shrink-0`}
          >
            <svg width="16" height="16" fill="white" viewBox="0 0 24 24">
              <path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-white truncate">
              {track.subtitle}
            </div>
          </div>
          <span class="label !text-[0.62rem] text-[var(--color-text-muted)] px-2 py-0.5 border border-[var(--color-line)]">
            {track.genre}
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- DOWNLOAD -->
<section class="relative z-10 rule py-20 px-5 md:px-10">
  <div class="max-w-[80rem] mx-auto flex flex-col md:flex-row md:items-center justify-between gap-8">
    <div>
      <h2 class="display-md text-white mb-3">
        {choose(locale, "Download the album", "Stáhnout celé album")}
      </h2>
      <p class="text-[var(--color-text-secondary)] max-w-md">
        {choose(
          locale,
          "All ten tracks in one ZIP file. Free, with no account required.",
          "Všech deset skladeb v jednom ZIP souboru. Zdarma, bez registrace.",
        )}
      </p>
    </div>
    <a
      href={`${base}media/album/tym-trampolin-digital-album.zip`}
      download
      class="btn-primary shrink-0"
    >
      {choose(locale, "Download album (ZIP)", "Stáhnout album (ZIP)")}
      <svg
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
    </a>
  </div>
</section>

<style>
  .track-item.active {
    background: rgba(94, 187, 255, 0.08);
    border-color: rgba(94, 187, 255, 0.3);
  }
  .track-item.active .track-number {
    color: var(--color-accent-bright);
  }
  #vinyl.spinning {
    animation: spin 4s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import "../../scripts/album";
</script>
